meta {
  name: Ajouter photo AVANT
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/interventions/{{interventionId}}/photos
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{tokenTechnicien}}
}

body:multipart-form {
  categorie: AVANT
  fichier: @file(assets/pixel.png)
}

script:post-response {
  bru.setEnvVar("photoId", res.getBody().id);
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.categorie: eq AVANT
  res.body.interventionId: eq {{interventionId}}
}
