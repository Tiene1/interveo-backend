meta {
  name: Ajouter photo AVANT (2e, ok)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/interventions/{{interventionId}}/photos
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{tokenTechnicien}}
}

body:multipart-form {
  categorie: AVANT
  fichier: @file(assets/pixel.png)
}

assert {
  res.status: eq 201
}
