  "info": {
    "title": "API SIM Interventions",
    "description": "Suivi des interventions techniques de la Societe Ivoire Maintenance.\n\nAuthentification par jeton JWT (Bearer). Recuperer un jeton via POST /auth/login,\npuis cliquer sur « Authorize » et le coller.\n\nRoles : DIRECTEUR (back-office) et TECHNICIEN (application mobile, synchronisation).",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "jwt": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "identifiant": {
            "type": "string"
          },
          "motDePasse": {
            "type": "string"
          }
        },
        "required": [
          "identifiant",
          "motDePasse"
        ]
      },
      "CreateInterventionDto": {
        "type": "object",
        "properties": {
          "nomClient": {
            "type": "string"
          },
          "adresse": {
            "type": "string"
          },
          "telephone1": {
            "type": "string"
          },
          "telephone2": {
            "type": "string"
          },
          "geolocalisation": {
            "type": "string"
          },
          "motifSignale": {
            "type": "string"
          },
          "datePrevue": {
            "format": "date-time",
            "type": "string"
          },
          "technicienId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "nomClient",
          "adresse",
          "telephone1",
          "datePrevue",
          "technicienId"
        ]
      },
      "PatchInterventionDto": {
        "type": "object",
        "properties": {
          "statut": {
            "type": "string",
            "enum": [
              "ANNULEE"
            ]
          },
          "nomClient": {
            "type": "string"
          },
          "adresse": {
            "type": "string"
          },
          "telephone1": {
            "type": "string"
          },
          "telephone2": {
            "type": "string"
          },
          "geolocalisation": {
            "type": "string"
          },
          "motifSignale": {
            "type": "string"
          },
          "datePrevue": {
            "format": "date-time",
            "type": "string"
          },
          "technicienId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
