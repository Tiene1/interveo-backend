# Port d'écoute de l'API
PORT=3000

# Origines autorisées pour les appels navigateur (CORS), separees par des virgules
CORS_ORIGIN="http://localhost:3001"

# Base de données PostgreSQL (docker-compose.dev.yml en local)
DATABASE_URL="postgresql://sim:sim@localhost:5432/sim_interventions?schema=public"

# Secret de signature des JWT
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="a_remplacer_par_une_valeur_longue_et_aleatoire"

# Stockage des photos : "fs" (disque local, dev) ou "cloudinary" (production :
# le disque de l'hebergeur gratuit est ephemere, efface a chaque redeploiement)
STOCKAGE_PHOTOS="fs"

# Dossier de stockage des photos quand STOCKAGE_PHOTOS="fs" (chemin relatif ou absolu)
PHOTOS_DIR="./var/photos"

# Requis uniquement quand STOCKAGE_PHOTOS="cloudinary" (dashboard Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Comptes créés par le seed (npx prisma db seed)
SEED_DIRECTEUR_IDENTIFIANT="kouassi"
SEED_DIRECTEUR_MOTDEPASSE="directeur123"
SEED_TECHNICIEN_MOTDEPASSE="technicien123"
