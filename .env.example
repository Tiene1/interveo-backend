# Port d'écoute de l'API
PORT=3000

# Base de données PostgreSQL (docker-compose.dev.yml en local)
DATABASE_URL="postgresql://sim:sim@localhost:5432/sim_interventions?schema=public"

# Secret de signature des JWT (activé au lot L1 Auth)
# JWT_SECRET="a_remplacer_par_une_valeur_longue_et_aleatoire"

# Dossier de stockage des photos (activé au lot L5 Photos)
# PHOTOS_DIR="./var/photos"

# Comptes créés par le seed (npx prisma db seed)
SEED_DIRECTEUR_IDENTIFIANT="kouassi"
SEED_DIRECTEUR_MOTDEPASSE="directeur123"
SEED_TECHNICIEN_MOTDEPASSE="technicien123"
